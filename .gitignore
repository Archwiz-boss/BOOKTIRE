# Real-case drawing and print PDFs
/cpami/Arch2016C/print/**/*.[pP][dD][fF]
/cpami/Arch2016C/pic/**/*.[pP][dD][fF]

# Local real-case data and legacy CPAMI program
/data.txt
/cpami/
/test/

# 真實案件封包（舊系統匯出的 ZIP，含身分證字號、地址、電話）。
# 為了除錯而放進工作區的案件檔一律不入版控——目前沒有任何 .zip 需要版控，
# 之後若真的要收錄，用 git add -f 或在這裡加 ! 例外，不要放寬這條規則。
*.zip
**/data.txt

# 舊系統安裝檔與其解壓內容（第三方程式，唯讀參考，不得散布）
*.msi

# Local development tools
/.tools/

# Optional SQLite template runtime data
/runtime/

# Build output: the .exe ships as a GitHub Release asset, not in the repo
/dist/
/build/
*.spec

# Generated GitHub Pages demo (rebuild with tools/build_demo.py)
/_site/

# Test-only dependencies (see package.json)
/node_modules/

# Python runtime cache
__pycache__/
*.py[cod]
